{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financial-agent-server",
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  // This date turns on the Node.js compatibility layer, including the
  // node:http server APIs and the in-memory node:fs virtual filesystem.
  // On dates on or after 2026-08-04 that layer is already on. Leave the
  // nodejs_compat flag unset; it is redundant here and does not add APIs.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // Workers AI has no local model. `remote: true` sends AI.run to the
  // account during `wrangler dev`. That call needs a Cloudflare token.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEDGER",
        "class_name": "Ledger"
      }
    ]
  },
  "exports": {
    "Ledger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // Non-secret configuration. Names of optional secrets are in
  // docs/cloudflare-workers-spike.md. Workers AI uses the binding, not a key.
  "vars": {
    "LLM_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "OLLAMA_MODEL": "llama3.1:latest",
    // Comma-separated browser origins. "*" is ignored. DevOps adds the
    // deployed UI origin here before a browser client calls this Worker.
    "CORS_ORIGIN": "http://localhost:8081"
  },
  // Paid plan only. The default is 30s of CPU; Free is 10ms and cannot run
  // this app. Ignored by `wrangler dev`.
  "limits": {
    "cpu_ms": 30000
  }
}
